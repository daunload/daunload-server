# 필수: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# 필수: 32자 이상 임의 문자열. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 관리자 학번 목록(JSON 배열). 비워 두면 관리자 접근 불가.
ADMIN_STUDENT_IDS=[]

# 로컬 실행 시 (docker compose에서는 compose 파일 값이 우선)
DATABASE_URL=postgresql+asyncpg://lms:lms@localhost:5432/lms
REDIS_URL=redis://localhost:6379/0

# 재생 설정
PLAYBACK_HEADLESS=true
PLAYBACK_BROWSER_CHANNEL=chrome
# 재생은 전용 큐에서 하나씩 처리합니다.
# 전사용 오디오 변환(ffmpeg) 동시 실행 수
MAX_AUDIO_STREAMS=4

# 개발용 CLI(python -m app.lms.*)에서 쓰는 본인 계정. 서버 운영에는 필요 없다.
LMS_ID=
LMS_PASSWORD=
