{
  "manifest_version": 3,
  "name": "SSU 강의 직접 다운로드",
  "description": "학교 CDN에서 강의 영상을 PC로 직접 저장합니다.",
  "version": "1.2.3",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.ssu.ac.kr/*",
    "https://*.commonscdn.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://daunload.cloud/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "SSU 다운로드 창 열기",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
