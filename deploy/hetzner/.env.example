# Public DNS name only; no scheme or path.
DOMAIN=lms.example.com
APP_IMAGE_TAG=local
# Generate the three secrets using the deployment guide before starting services.
# POSTGRES_PASSWORD must be URL-safe (the guide generates hexadecimal characters).
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
FERNET_KEY=CHANGE_ME_FERNET
JWT_SECRET=CHANGE_ME_JWT
PLAYBACK_HEADLESS=true
PLAYBACK_BROWSER_CHANNEL=chrome
TIMEZONE=Asia/Seoul
TZ=Asia/Seoul
# Close Chrome after the playback queue has been empty this many seconds (0 keeps it open).
# Start at 0, measure idle worker memory with `docker stats`, then try 600.
PLAYBACK_BROWSER_IDLE_SECONDS=0
# Relaunch Chrome between videos after this many hours (0 disables).
PLAYBACK_BROWSER_MAX_AGE_HOURS=0
